{
  "defaultBranch": "main",
  "projectType": "python-package",
  "docs": {
    "overview": "README.md",
    "operations": "docs/ops/repairshopr-sync-confidence-runbook.md",
    "packageManifest": "pyproject.toml",
    "lockfile": "uv.lock"
  },
  "qualityGate": {
    "setup": {
      "default": "uv sync --locked --group dev"
    },
    "test": {
      "default": "uv run pytest -q",
      "coverage": "uv run pytest --cov --cov-report=term-missing",
      "mariadbIntegration": "uv sync --locked --group dev --extra sync && export RUN_MARIADB_INTEGRATION=1 MARIADB_HOST=127.0.0.1 MARIADB_PORT=3306 MARIADB_DATABASE=repairshopr_test MARIADB_USER=repairshopr_api MARIADB_PASSWORD=root && uv run python -m django migrate --noinput --settings=tests.django_settings_mariadb && uv run pytest -q -m integration --ds=tests.django_settings_mariadb --no-cov"
    },
    "format": {
      "default": "uv run black --check ."
    },
    "build": {
      "package": "uv build"
    },
    "lockfile": {
      "check": "./scripts/check-lockfile.sh",
      "refresh": "uv lock"
    },
    "configAuthority": {
      "workflow": "cbusillo/launchplane/.github/workflows/reusable-product-repo-config-authority.yml@fddedd31063c42903f33df9a62120fbb38dd923a"
    },
    "inspection": {
      "tool": "jetbrains",
      "ide": "PyCharm",
      "scopePreference": [
        "changed_files",
        "directory",
        "whole_project"
      ]
    },
    "docsRequiredWhen": [
      "behavior changes",
      "api changes",
      "config changes",
      "operations changes",
      "sync behavior changes",
      "database schema or migration behavior changes",
      "dependency or packaging metadata changes",
      "release workflow changes"
    ]
  },
  "importantWorkflows": [
    "Test Suite",
    "Launchplane Recovery Request",
    "Launchplane Deploy",
    "Publish to PyPI",
    "CodeQL",
    "Dependency Graph",
    "Dependabot Updates"
  ],
  "requiredStatusChecks": ["test", "mysql-integration"],
  "codeScanningMergeProtection": {
    "ruleset": "Require code scanning results",
    "tool": "CodeQL",
    "alertsThreshold": "errors",
    "securityAlertsThreshold": "high_or_higher",
    "dependabotDefaultSetupException": true
  },
  "qaLabels": [],
  "deployLabels": [],
  "healthUrls": [],
  "relatedRepos": [],
  "githubSignals": {
    "postMerge": {
      "waitForActions": true,
      "checkSecurityAndQuality": true
    },
    "capabilities": {
      "codeScanning": "available",
      "secretScanning": "available",
      "dependabotAlerts": "available",
      "securityAdvisories": "available"
    },
    "refreshWhen": [
      "repo visibility changes",
      "GitHub plan changes",
      "security settings change",
      "token permissions change"
    ]
  },
  "cleanup": {
    "deleteMergedLocalBranches": true,
    "removeMergedCleanWorktrees": true
  },
  "metadataFreshness": {
    "updateWhen": [
      "docs routing changes",
      "validation gates change",
      "primary commands change",
      "important workflows change",
      "repo relationship changes",
      "cleanup policy changes",
      "release workflow changes",
      "dependency or packaging metadata changes",
      "sync operation workflow changes"
    ]
  }
}
